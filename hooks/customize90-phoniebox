#!/bin/bash
set -euo pipefail

ROOTFS="${1:?Expected target root filesystem path}"

PHONIEBOX_GIT_BRANCH="${PHONIEBOX_GIT_BRANCH:-future3/develop}"

# Clone from the fork: it contains our modifications (e.g. the
# non-interactive RFID reader registration in run_register_rfid_reader.py)
# that the upstream MiczFlor repo does not have.
if [ ! -d "$ROOTFS/opt/Phoniebox/.git" ]; then
    chroot "$ROOTFS" git clone \
        --branch "$PHONIEBOX_GIT_BRANCH" \
        https://github.com/xeonqq/RPi-Jukebox-RFID.git \
        /opt/Phoniebox
fi

# Exec bits can get lost depending on how the overlay is applied.
chmod 0755 "$ROOTFS/usr/local/sbin/phoniebox-firstboot" \
           "$ROOTFS/usr/local/sbin/phoniebox-install-unattended" \
           "$ROOTFS/usr/local/sbin/phoniebox-wifi-setup" \
           "$ROOTFS/usr/local/sbin/phoniebox-wifi-portal" \
           "$ROOTFS/usr/local/sbin/phoniebox-wifi-connect" \
           "$ROOTFS/usr/local/sbin/phoniebox-hotspot" \
           "$ROOTFS/usr/local/sbin/phoniebox-expand-rootfs"

# Stale byte code from the build host must not end up in the image.
rm -rf "$ROOTFS/usr/local/sbin/__pycache__"

chroot "$ROOTFS" systemctl enable phoniebox-firstboot.service

# The root filesystem only covers the image content; the installation
# needs the whole SD card (growpart + resize2fs on first boot).
chroot "$ROOTFS" systemctl enable phoniebox-expand-rootfs.service

# Docker daemon must run at boot; the MeTube container itself is started by
# phoniebox-metube.service, which is gated on the existence of the music
# library dir (created by the Phoniebox installation on first boot).
chroot "$ROOTFS" systemctl enable docker.service
chroot "$ROOTFS" systemctl enable phoniebox-metube.service

cat > "$ROOTFS/etc/phoniebox-image/README" <<'EOF'
Phoniebox image first-boot flow
===============================

On first boot the device:
1. brings up NetworkManager,
2. uses WiFi credentials from /boot/firmware/phoniebox-wifi.conf if present,
3. otherwise opens a bootstrap hotspot (see /etc/phoniebox-image/preseed.env),
4. runs the Phoniebox installation unattended as soon as it has internet.

Home WiFi can be set over the hotspot via SSH:
  sudo phoniebox-wifi-setup "SSID" "PSK" [COUNTRY]

Installer options are pre-selected in /etc/phoniebox-image/preseed.env.
EOF
