[Unit]
Description=Phoniebox first-boot installation
Wants=NetworkManager.service
After=NetworkManager.service
ConditionPathExists=!/var/lib/phoniebox-image/initialized

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/phoniebox-firstboot
TimeoutStartSec=0
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
