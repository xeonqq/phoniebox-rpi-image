[Unit]
Description=Phoniebox WiFi access point (%i)
Documentation=file:/usr/local/sbin/phoniebox-hotspot
After=NetworkManager.service
# Only one access point at a time - phoniebox-hotspot stops the other
# instance when it starts (a Conflicts= on the instance itself would keep
# the unit from starting at all).

[Service]
Type=simple
Environment=PHONIEBOX_HOTSPOT_MODE=%i
ExecStart=/usr/local/sbin/phoniebox-hotspot run
ExecStop=/usr/local/sbin/phoniebox-hotspot stop
Restart=on-failure
RestartSec=5
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
