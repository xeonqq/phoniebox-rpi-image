# /etc/phoniebox-image/preseed.env
#
# Pre-selected answers for the interactive Phoniebox installer.
# This file is sourced by the first-boot service (root) and by the
# unattended installer driver (phoniebox user), so every variable set
# here is applied without any prompt on the device.
#
# Change values, rebuild the image, and the new settings are baked in.

# --- Account / source -------------------------------------------------
# Unix user the Phoniebox software is installed for.
# Must match device.user1 in config/phoniebox-pi3.yaml.
PHONIEBOX_USER=phoniebox

# Only used if the staged repo copy in /opt/Phoniebox is missing and
# the source has to be downloaded on first boot.
GIT_USER=xeonqq
GIT_BRANCH=future3/develop

# --- Installer option variables ---------------------------------------
# These replace the interactive questions of installation/routines/
# customize_options.sh. Defaults mirror the installer defaults except
# ENABLE_AUTOHOTSPOT (enabled here) and ENABLE_RFID_READER (disabled
# because the reader type can only be picked interactively; register
# your reader later via SSH: installation/components/setup_rfid_reader.sh)

ENABLE_AUTOHOTSPOT=true
AUTOHOTSPOT_PROFILE=Phoniebox_Hotspot
AUTOHOTSPOT_PASSWORD=PlayItLoud!
AUTOHOTSPOT_COUNTRYCODE=DE
AUTOHOTSPOT_IP=10.0.0.1
DISABLE_IPv6=true
DISABLE_BLUETOOTH=true
DISABLE_ONBOARD_AUDIO=false
SETUP_MPD=true
ENABLE_MPD_OVERWRITE_INSTALL=true
ENABLE_RFID_READER=true
ENABLE_SAMBA=true
ENABLE_WEBAPP=true
# The image is built from the xeonqq fork; web app bundles for custom
# commits are published by the fork's CI under the 'webapp-development'
# release tag, so the development bundle download must be enabled.
ENABLE_WEBAPP_PROD_DOWNLOAD=true
ENABLE_KIOSK_MODE=false
UPDATE_RASPI_OS=false

# Static IP cannot be combined with the WiFi hotspot; it stays off.
ENABLE_STATIC_IP=false

# --- First-boot / bootstrap hotspot (pre-installation) -----------------
# Before the Phoniebox installer has run there is no autohotspot yet.
# If the box does not get internet access on its own, the first-boot
# service opens this temporary hotspot. Connect to it, SSH in
# (user/password of the image), then run:
#   sudo phoniebox-wifi-setup "YourHomeSSID" "YourHomePassword"
BOOTSTRAP_SSID=Phoniebox_Setup
BOOTSTRAP_PASSWORD=PlayItLoud!
BOOTSTRAP_IP=10.0.0.1

# Reboot automatically once the installation finished.
REBOOT_AFTER_INSTALL=true

# --- MeTube (YouTube downloader via Docker) -----------------------------
# Runs as a docker container, exposed on port 8081 of the box.
# The Jukebox web app links to it on the Settings page
# ("Download Music (i.e. YouTube)").
ENABLE_METUBE=true
METUBE_PORT=8081