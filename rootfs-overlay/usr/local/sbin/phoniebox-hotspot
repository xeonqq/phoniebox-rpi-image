#!/usr/bin/env bash
# /usr/local/sbin/phoniebox-hotspot  (runs as root)
#
# WiFi access point of the Phoniebox, based on hostapd.
#
# Why not NetworkManager? NM only supports access points through its
# wpa_supplicant backend and that does not work with the brcmfmac driver of
# the Raspberry Pi 3 (BCM43430/1):
#
#   nl80211: kernel reports: key setting validation failed
#   wlan0: Could not connect to kernel driver
#   wlan0: Failed to initialize AP interface
#   Error: Connection activation failed: 802.1X supplicant took too long
#          to authenticate
#
# hostapd drives the same hardware without problems, so the access point
# runs hostapd while NetworkManager keeps managing the client side (the
# radio is handed over to hostapd while the hotspot is up).
#
# Usage:
#   phoniebox-hotspot run [bootstrap|autohotspot]  (foreground, for systemd)
#   phoniebox-hotspot start [bootstrap|autohotspot]
#   phoniebox-hotspot stop
#   phoniebox-hotspot status
#   phoniebox-hotspot autohotspot                  (enable/disable by internet)
#
set -uo pipefail

PRESEED_FILE=/etc/phoniebox-image/preseed.env
HOSTAPD_CONF=/etc/hostapd/phoniebox.conf
HOSTAPD_BIN=/usr/sbin/hostapd
HOSTAPD_PIDFILE=/run/phoniebox-hostapd.pid
DNSMASQ_CONF=/etc/phoniebox-image/dnsmasq-hotspot.conf
DNSMASQ_BIN=/usr/sbin/dnsmasq
DNSMASQ_PIDFILE=/run/phoniebox-dnsmasq.pid
LOGFILE=/var/log/phoniebox-hotspot.log
CHECK_URL=${HOTSPOT_CHECK_URL:-http://deb.debian.org/}
HOTSPOT_SERVICE="phoniebox-hotspot@.service"
AUTOHOTSPOT_INSTANCE="phoniebox-hotspot@autohotspot.service"
BOOTSTRAP_INSTANCE="phoniebox-hotspot@bootstrap.service"

[ -f "$PRESEED_FILE" ] && . "$PRESEED_FILE"

WIFI_IF=${WIFI_IF:-}
HOTSPOT_CHANNEL=${HOTSPOT_CHANNEL:-1}

log() {
    echo "[phoniebox-hotspot $(date '+%F %T')] $*"
    logger -t phoniebox-hotspot "$*" 2>/dev/null || true
}

mkdir -p /etc/hostapd /etc/phoniebox-image
exec > >(tee -a "$LOGFILE") 2>&1

detect_wifi_iface() {
    local dev
    dev=$(nmcli -t -f DEVICE,TYPE device status 2>/dev/null \
          | awk -F: '$2 == "wifi" { print $1; exit }')
    if [ -z "$dev" ]; then
        for dev in /sys/class/net/*/wireless; do
            [ -e "$dev" ] || continue
            dev=${dev%/wireless}
            echo "${dev##*/}"
            return 0
        done
        return 1
    fi
    echo "$dev"
}

# The hotspot parameters depend on the phase the box is in: the setup
# hotspot while the Phoniebox is installed, the autohotspot afterwards.
load_settings() {
    local mode="${1:-bootstrap}"
    case "$mode" in
        autohotspot)
            HOTSPOT_SSID=${AUTOHOTSPOT_SSID:-${AUTOHOTSPOT_PROFILE:-Phoniebox_Hotspot}_$(hostname)}
            HOTSPOT_PASSWORD=${AUTOHOTSPOT_PASSWORD:-PlayItLoud!}
            HOTSPOT_IP=${AUTOHOTSPOT_IP:-10.0.0.1}
            HOTSPOT_COUNTRY=${AUTOHOTSPOT_COUNTRYCODE:-DE}
            ;;
        *)
            HOTSPOT_SSID=${BOOTSTRAP_SSID:-Phoniebox_Setup}
            HOTSPOT_PASSWORD=${BOOTSTRAP_PASSWORD:-PlayItLoud!}
            HOTSPOT_IP=${BOOTSTRAP_IP:-10.0.0.1}
            HOTSPOT_COUNTRY=${BOOTSTRAP_COUNTRY:-DE}
            ;;
    esac
    if [ -z "$WIFI_IF" ]; then
        WIFI_IF=$(detect_wifi_iface) || WIFI_IF=wlan0
    fi
}

write_hostapd_conf() {
    cat > "$HOSTAPD_CONF" <<EOF
# Generated by phoniebox-hotspot - do not edit
interface=$WIFI_IF
driver=nl80211
ssid=$HOTSPOT_SSID
hw_mode=g
channel=$HOTSPOT_CHANNEL
country_code=$HOTSPOT_COUNTRY
ieee80211n=1
wmm_enabled=1
auth_algs=1
wpa=2
wpa_passphrase=$HOTSPOT_PASSWORD
wpa_key_mgmt=WPA-PSK
rsn_pairwise=CCMP
EOF
    chmod 0600 "$HOSTAPD_CONF"
}

write_dnsmasq_conf() {
    local net="${HOTSPOT_IP%.*}"
    cat > "$DNSMASQ_CONF" <<EOF
# Generated by phoniebox-hotspot - do not edit
interface=$WIFI_IF
bind-interfaces
listen-address=$HOTSPOT_IP
dhcp-range=$net.100,$net.150,255.255.255.0,12h
dhcp-option=option:router,$HOTSPOT_IP
dhcp-option=option:dns-server,$HOTSPOT_IP
dhcp-authoritative
EOF
}

# Prepare the interface for hostapd: NetworkManager must not manage the
# radio while the access point is up.
prepare_interface() {
    log "preparing $WIFI_IF for the access point"
    nmcli device set "$WIFI_IF" managed no >/dev/null 2>&1 || true
    systemctl stop wpa_supplicant.service >/dev/null 2>&1 || true
    ip link set dev "$WIFI_IF" down 2>/dev/null || true
    ip addr flush dev "$WIFI_IF" 2>/dev/null || true
    ip addr add "${HOTSPOT_IP}/24" dev "$WIFI_IF" 2>/dev/null || true
    ip link set dev "$WIFI_IF" up 2>/dev/null || true
    [ -n "$HOTSPOT_COUNTRY" ] && iw reg set "$HOTSPOT_COUNTRY" 2>/dev/null
}

cleanup_interface() {
    log "releasing $WIFI_IF"
    if [ -f "$DNSMASQ_PIDFILE" ]; then
        kill "$(cat "$DNSMASQ_PIDFILE")" 2>/dev/null || true
        rm -f "$DNSMASQ_PIDFILE"
    fi
    ip addr flush dev "$WIFI_IF" 2>/dev/null || true
    ip link set dev "$WIFI_IF" up 2>/dev/null || true
    # give the radio back to NetworkManager
    nmcli device set "$WIFI_IF" managed yes >/dev/null 2>&1 || true
    systemctl start wpa_supplicant.service >/dev/null 2>&1 || true
}

# Run the access point in the foreground (systemd supervises it).
cmd_run() {
    local mode="${1:-bootstrap}"
    local other
    case "$mode" in
        autohotspot) other="$BOOTSTRAP_INSTANCE" ;;
        *)           other="$AUTOHOTSPOT_INSTANCE" ;;
    esac
    # Only one access point at a time - the radio can only do one thing.
    if systemctl is-active --quiet "$other"; then
        log "stopping $other - only one access point at a time"
        systemctl stop "$other"
        sleep 2
    fi

    load_settings "$mode"
    write_hostapd_conf
    write_dnsmasq_conf
    prepare_interface

    trap 'cleanup_interface; exit 0' INT TERM

    "$DNSMASQ_BIN" --conf-file="$DNSMASQ_CONF" --keep-in-foreground \
        --pid-file="$DNSMASQ_PIDFILE" &
    local dnsmasq_pid=$!
    "$HOSTAPD_BIN" -P "$HOSTAPD_PIDFILE" "$HOSTAPD_CONF" &
    local hostapd_pid=$!

    log "access point '$HOTSPOT_SSID' running on $WIFI_IF ($HOTSPOT_IP)"

    wait "$hostapd_pid"
    local rc=$?
    # systemd stops the service with SIGTERM - that is not an error
    if [ "$rc" -gt 128 ]; then
        rc=0
    fi
    kill "$dnsmasq_pid" 2>/dev/null || true
    cleanup_interface
    return $rc
}

cmd_start() {
    local mode="${1:-bootstrap}"
    local instance
    case "$mode" in
        autohotspot) instance="$AUTOHOTSPOT_INSTANCE" ;;
        *)           instance="$BOOTSTRAP_INSTANCE" ;;
    esac
    log "starting $instance"
    systemctl start "$instance"
    sleep 3
    cmd_status
}

cmd_stop() {
    log "stopping the access point"
    systemctl stop "$AUTOHOTSPOT_INSTANCE" 2>/dev/null || true
    systemctl stop "$BOOTSTRAP_INSTANCE" 2>/dev/null || true
    cleanup_interface
}

cmd_status() {
    local state="down"
    systemctl is-active --quiet "$BOOTSTRAP_INSTANCE" && state="bootstrap up"
    systemctl is-active --quiet "$AUTOHOTSPOT_INSTANCE" && state="autohotspot up"
    log "hotspot state: $state"
    iw dev "$WIFI_IF" info 2>/dev/null | sed 's/^/    /'
    nmcli -f SSID,MODE,CHAN,SECURITY device wifi list ifname "$WIFI_IF" 2>/dev/null \
        | grep -i "$HOTSPOT_SSID" | sed 's/^/    /' || true
}

have_internet() {
    getent hosts deb.debian.org >/dev/null 2>&1 || return 1
    curl -4 -fsS -m 8 -o /dev/null "$CHECK_URL"
}

# Name of a stored WiFi connection (if the box knows a network at all).
known_wifi_profile() {
    nmcli -t -f NAME,TYPE connection show 2>/dev/null \
        | awk -F: '$2 == "802-11-wireless" { print $1; exit }'
}

# Start the autohotspot when there is no internet, stop it otherwise.
#
# The access point owns the radio, so while it is up the box cannot be
# online - the internet check would always fail and the hotspot would stay
# up forever. Therefore the hotspot is cycled: it is stopped, NetworkManager
# gets a chance to reconnect to a known network and the hotspot only comes
# back if the box is still offline.
cmd_autohotspot() {
    if systemctl is-active --quiet "$AUTOHOTSPOT_INSTANCE"; then
        if have_internet; then
            log "internet is available - stopping the autohotspot"
            systemctl stop "$AUTOHOTSPOT_INSTANCE"
            return
        fi
        if [ -z "$(known_wifi_profile)" ]; then
            log "no known WiFi network - keeping the autohotspot up"
            return
        fi
        log "no internet - looking for the known WiFi network"
        systemctl stop "$AUTOHOTSPOT_INSTANCE"
        sleep 25   # let NetworkManager reconnect (autoconnect)
        if have_internet; then
            log "internet is back - the autohotspot stays off"
            return
        fi
        log "still offline - starting the autohotspot again"
        systemctl start "$AUTOHOTSPOT_INSTANCE"
    else
        if ! have_internet; then
            log "no internet - starting the autohotspot"
            systemctl start "$AUTOHOTSPOT_INSTANCE"
        fi
    fi
}

case "${1:-}" in
    run)        cmd_run "${2:-${PHONIEBOX_HOTSPOT_MODE:-bootstrap}}" ;;
    start)      cmd_start "${2:-bootstrap}" ;;
    stop)       cmd_stop ;;
    status)     cmd_status ;;
    autohotspot) cmd_autohotspot ;;
    *)
        echo "usage: ${0##*/} {run|start|stop|status|autohotspot} [bootstrap|autohotspot]" >&2
        exit 1
        ;;
esac
