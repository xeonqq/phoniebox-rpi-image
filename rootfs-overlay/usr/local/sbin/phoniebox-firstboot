#!/usr/bin/env bash
# /usr/local/sbin/phoniebox-firstboot  (runs as root, once per image)
#
# Flow:
#   1. Make NetworkManager the only network manager of the system.
#   2. If /boot/firmware/phoniebox-wifi.conf exists, connect to that WiFi.
#   3. Otherwise open a temporary bootstrap WiFi hotspot - right away, no
#      long "waiting for internet" phase in front of it - so the user can
#      connect and configure the home WiFi.
#   4. As soon as the box has internet, run the Phoniebox installation
#      non-interactively with options from /etc/phoniebox-image/preseed.env.
#   5. Clean up, mark done, reboot (optional).
#
# Every nmcli call is logged (output included) - the log file is the only
# way to find out why the hotspot did not come up on the device.

set -uo pipefail

STATUS_DIR=/var/lib/phoniebox-image
LOGFILE=/var/log/phoniebox-firstboot.log
PRESEED_FILE=/etc/phoniebox-image/preseed.env
BOOT_WIFI_CONF=/boot/firmware/phoniebox-wifi.conf
CHECK_URL=http://deb.debian.org/
HOME_WIFI_CON=phoniebox-home
GRACE_PERIOD=30         # seconds to wait for an existing (wired) internet link
WIFI_CONF_TIMEOUT=120   # seconds to wait after applying boot wifi conf
WAIT_LOOP_MAX=86400     # max seconds waiting for the user to configure wifi
HOTSPOT_ATTEMPTS=3      # how often the hotspot is retried

[ -f "$PRESEED_FILE" ] && . "$PRESEED_FILE"

PHONIEBOX_USER=${PHONIEBOX_USER:-phoniebox}
BOOTSTRAP_SSID=${BOOTSTRAP_SSID:-Phoniebox_Setup}
BOOTSTRAP_PASSWORD=${BOOTSTRAP_PASSWORD:-PlayItLoud!}
BOOTSTRAP_IP=${BOOTSTRAP_IP:-10.0.0.1}
BOOTSTRAP_BAND=${BOOTSTRAP_BAND:-bg}
BOOTSTRAP_COUNTRY=${BOOTSTRAP_COUNTRY:-DE}
WIFI_IF=${WIFI_IF:-}
REBOOT_AFTER_INSTALL=${REBOOT_AFTER_INSTALL:-true}

mkdir -p "$STATUS_DIR"
exec >>"$LOGFILE" 2>&1

log() {
    echo "[phoniebox-firstboot $(date '+%F %T')] $*"
    logger -t phoniebox-firstboot "$*" 2>/dev/null || true
}

# A weak power supply makes the Pi under-volt. The SD card then gets
# corrupted (ext4 checksum errors, filesystem remounted read-only) and the
# installation dies with confusing errors - warn about it right away.
check_power_supply() {
    local state
    state=$(vcgencmd get_throttled 2>/dev/null) || return 0
    case "$state" in
        *0x0|*0x00000) return 0 ;;
    esac
    log "WARNING: power problem detected (${state})"
    log "WARNING: 0x10000 = under-voltage, 0x40000 = throttled, 0x80000 = soft temperature limit"
    log "WARNING: use a 5V/2.5A power supply and a good cable - otherwise the SD card gets corrupted"
}

# Internet means: name resolution works *and* an HTTP request succeeds.
# Without DNS the installer (apt) would fail later on, so do not accept a
# half-connected link here.
have_internet() {
    getent hosts deb.debian.org >/dev/null 2>&1 || return 1
    curl -4 -fsS -m 8 -o /dev/null "$CHECK_URL"
}

# NetworkManager must be the only network manager of the system. The other
# ones (systemd-networkd, iwd, the standalone dnsmasq) are either grabbing
# the WiFi device or the DNS port and would break the hotspot.
stop_other_network_managers() {
    # systemd-networkd configures wlan0/eth0 on its own (and needs iwd for
    # WiFi) - it has to go before NetworkManager takes the device.
    systemctl disable --now systemd-networkd.service systemd-networkd.socket \
        systemd-networkd-wait-online.service 2>/dev/null || true
    # iwd takes over the WiFi device via netifd and blocks wpa_supplicant/NM
    systemctl disable --now iwd.service 2>/dev/null || true
    systemctl mask iwd.service 2>/dev/null || true
    # The standalone dnsmasq binds 0.0.0.0:53 and clashes with the dnsmasq
    # instance NetworkManager starts for the hotspot (ipv4.method shared).
    systemctl disable --now dnsmasq.service 2>/dev/null || true
}

setup_networkmanager() {
    rfkill unblock all 2>/dev/null || true
    stop_other_network_managers
    systemctl enable NetworkManager 2>/dev/null || true
    systemctl start NetworkManager
    local i
    for i in $(seq 1 30); do
        nmcli general status >/dev/null 2>&1 && return 0
        sleep 1
    done
    return 1
}

# Name of the WiFi device (wlan0 on a Pi 3, but do not rely on it).
detect_wifi_iface() {
    local dev
    dev=$(nmcli -t -f DEVICE,TYPE device status 2>/dev/null \
          | awk -F: '$2 == "wifi" { print $1; exit }')
    if [ -z "$dev" ]; then
        for dev in /sys/class/net/*/wireless; do
            [ -e "$dev" ] || continue
            dev=${dev%/wireless}
            echo "${dev##*/}"
            return 0
        done
        return 1
    fi
    echo "$dev"
}

prepare_wifi() {
    # Cycle the radio: if iwd had the device, NM does not get it back on
    # its own - it has to recreate the wpa_supplicant interface.
    nmcli radio wifi off >/dev/null 2>&1 || true
    sleep 2
    nmcli radio wifi on >/dev/null 2>&1 || true
    local i
    for i in $(seq 1 60); do
        WIFI_IF=$(detect_wifi_iface) && [ -n "$WIFI_IF" ] && break
        sleep 1
    done
    if [ -z "$WIFI_IF" ]; then
        WIFI_IF=wlan0
        log "WARNING: no WiFi device found, assuming '$WIFI_IF'"
    else
        log "WiFi device: '$WIFI_IF'"
    fi
    nmcli device set "$WIFI_IF" managed yes 2>/dev/null || true
    sleep 2
    log "NM device status:"
    nmcli device status
    nmcli -f WIFI-PROPERTIES.AP device show "$WIFI_IF" 2>&1 | sed 's/^/    /'
}

wifi_connect() { # $1 con-name  $2 ssid  $3 psk
    log "Connecting to WiFi '$2' (profile '$1')"
    nmcli connection delete "$1" >/dev/null 2>&1 || true
    nmcli connection add type wifi con-name "$1" ifname "$WIFI_IF" \
        ssid "$2" 802-11-wireless-security.key-mgmt wpa-psk \
        802-11-wireless-security.psk "$3" connection.autoconnect yes
    nmcli connection up "$1"
}

provision_wifi_from_boot() {
    [ -f "$BOOT_WIFI_CONF" ] || return 1
    local ssid psk country
    ssid=$(sed -n 's/^SSID=//p' "$BOOT_WIFI_CONF" | head -n1)
    psk=$(sed -n 's/^PSK=//p' "$BOOT_WIFI_CONF" | head -n1)
    country=$(sed -n 's/^COUNTRY=//p' "$BOOT_WIFI_CONF" | head -n1)
    if [ -z "$ssid" ] || [ -z "$psk" ]; then
        log "WARNING: $BOOT_WIFI_CONF exists but lacks SSID=/PSK= lines"
        return 1
    fi
    [ -n "$country" ] && iw reg set "$country" 2>/dev/null
    wifi_connect "$HOME_WIFI_CON" "$ssid" "$psk"
}

# Create and activate the bootstrap access point.
#
# The access point is run by hostapd, not by NetworkManager: NM's
# wpa_supplicant backend cannot create an access point with the brcmfmac
# driver of the Pi 3 ("key setting validation failed"). See
# /usr/local/sbin/phoniebox-hotspot.
start_bootstrap_hotspot() {
    local attempt

    for attempt in $(seq 1 "$HOTSPOT_ATTEMPTS"); do
        log "Starting bootstrap hotspot SSID='$BOOTSTRAP_SSID' (attempt $attempt/$HOTSPOT_ATTEMPTS)"
        if systemctl start phoniebox-hotspot@bootstrap.service; then
            sleep 3
            if systemctl is-active --quiet phoniebox-hotspot@bootstrap.service; then
                log "Bootstrap hotspot '$BOOTSTRAP_SSID' is up on $WIFI_IF"
                iw dev "$WIFI_IF" info 2>&1 | sed 's/^/    /'
                # Start the Wi-Fi setup portal so users can pick their home
                # network from a webpage (http://10.0.0.1/) instead of using
                # the CLI.
                if systemctl start phoniebox-wifi-portal.service; then
                    log "Wi-Fi setup portal is running at http://$BOOTSTRAP_IP/"
                else
                    log "WARNING: failed to start the Wi-Fi setup portal"
                fi
                return 0
            fi
            log "ERROR: the hotspot service did not stay up"
        else
            log "ERROR: the hotspot service failed to start"
        fi
        journalctl -u phoniebox-hotspot@bootstrap.service --no-pager -n 20 2>&1 \
            | sed 's/^/    /'
        sleep 10
    done
    return 1
}

run_install() {
    local user="$PHONIEBOX_USER"
    local home ugroup
    home=$(getent passwd "$user" | cut -d: -f6)
    ugroup=$(id -gn "$user")
    if [ -z "$home" ]; then
        log "ERROR: user $user does not exist"
        return 1
    fi
    log "Starting unattended Phoniebox installation for $user (home $home)"

    export DEBIAN_FRONTEND=noninteractive
    # The installer routines need root for apt/systemctl. Grant passwordless
    # sudo for the duration of the install.
    #
    # The file name matters: sudo applies the *last* matching rule, and the
    # image ships /etc/sudoers.d/010_rpi-passwd (user1 ALL=(ALL:ALL) ALL,
    # i.e. password required). "zz-..." sorts after it, so NOPASSWD wins.
    printf '%s ALL=(ALL) NOPASSWD: ALL\nDefaults env_keep += "DEBIAN_FRONTEND"\n' "$user" \
        > /etc/sudoers.d/zz-phoniebox-nopasswd
    chmod 0440 /etc/sudoers.d/zz-phoniebox-nopasswd

    # Stage the pinned Phoniebox source that was cloned at build time.
    if [ ! -d "$home/RPi-Jukebox-RFID" ] && [ -d /opt/Phoniebox/.git ]; then
        cp -a /opt/Phoniebox "$home/RPi-Jukebox-RFID"
        chown -R "$user:$ugroup" "$home/RPi-Jukebox-RFID"
        log "Staged /opt/Phoniebox into $home/RPi-Jukebox-RFID"
    fi

    rm -f "$home/.phoniebox-install-success" "$home/.phoniebox-install-failed"

    # The Phoniebox web app (nginx) needs port 80. The setup portal has to
    # give it up *before* the installation starts, otherwise nginx fails to
    # bind and the web app is not reachable (the setup page would answer
    # on http://phoniebox.local instead).
    systemctl stop phoniebox-wifi-portal.service 2>/dev/null || true

    if runuser -l "$user" -c /usr/local/sbin/phoniebox-install-unattended; then
        log "Installer driver finished"
    else
        log "Installer driver returned a non-zero status"
    fi

    if [ -f "$home/.phoniebox-install-success" ]; then
        # jukebox-daemon is a systemd *user* service; linger keeps the user
        # manager running without an interactive login.
        loginctl enable-linger "$user" 2>/dev/null || true
        # Stop the setup portal - no longer needed once installation begins.
        systemctl stop phoniebox-wifi-portal.service 2>/dev/null || true
        # The setup hotspot is replaced by the autohotspot from now on.
        systemctl stop phoniebox-hotspot@bootstrap.service 2>/dev/null || true
        systemctl enable phoniebox-autohotspot.timer 2>/dev/null || true
        # The installation may have re-enabled other network managers or the
        # standalone dnsmasq (package postinst scripts) - they would break
        # the hotspot after the reboot.
        stop_other_network_managers
        touch "$STATUS_DIR/initialized"
        log "Phoniebox installation complete"
        return 0
    fi
    log "Installation FAILED - check $home/INSTALL-*.log"
    return 1
}

### main -----------------------------------------------------------------

[ -f "$STATUS_DIR/initialized" ] && { log "Already initialized"; exit 0; }
log "First boot - phoniebox image initialization"
check_power_supply

setup_networkmanager || { log "FATAL: NetworkManager did not come up"; exit 1; }
prepare_wifi

# 1) A wired connection may already provide internet - short grace period.
got=0
waited=0
while [ "$waited" -lt "$GRACE_PERIOD" ]; do
    if have_internet; then got=1; break; fi
    sleep 5
    waited=$((waited + 5))
done

# 2) Try WiFi credentials baked into the boot partition.
if [ "$got" -eq 0 ] && provision_wifi_from_boot; then
    waited=0
    while [ "$waited" -lt "$WIFI_CONF_TIMEOUT" ]; do
        if have_internet; then got=1; break; fi
        sleep 5
        waited=$((waited + 5))
    done
    [ "$got" -eq 0 ] && log "WARNING: no internet with the WiFi from $BOOT_WIFI_CONF"
fi

# 3) Still offline: open the bootstrap hotspot now and wait for the user.
if [ "$got" -eq 0 ]; then
    if start_bootstrap_hotspot; then
        log "Bootstrap hotspot is up. Connect to '$BOOTSTRAP_SSID',"
        log "then open http://$BOOTSTRAP_IP/ in a browser and follow the setup page"
        log "(or SSH in and run: sudo phoniebox-wifi-setup \"SSID\" \"PSK\")"
    else
        log "WARNING: the bootstrap hotspot could not be started - see the errors above"
    fi
    waited=0
    while ! have_internet; do
        sleep 10
        waited=$((waited + 10))
        if [ $((waited % 300)) -eq 0 ]; then
            log "Still waiting for internet access (${waited}s)"
        fi
        if [ "$waited" -ge "$WAIT_LOOP_MAX" ]; then
            log "FATAL: no connectivity after ${WAIT_LOOP_MAX}s - giving up"
            exit 1
        fi
    done
fi

log "Internet access detected - running installer"

if ! run_install; then
    exit 1
fi

if [ "$REBOOT_AFTER_INSTALL" = true ]; then
    log "Rebooting to finish setup"
    systemctl reboot
fi
exit 0
