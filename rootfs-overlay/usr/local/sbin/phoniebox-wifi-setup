#!/usr/bin/env bash
# Configure the home WiFi from a shell, e.g. while connected to the
# bootstrap hotspot. The first-boot service will automatically start the
# Phoniebox installation as soon as internet access is available.
#
# Usage: sudo phoniebox-wifi-setup "SSID" "PSK" [COUNTRY]
set -euo pipefail

if [ "$#" -lt 2 ] || [ "$#" -gt 3 ]; then
    echo "Usage: sudo $0 \"SSID\" \"PSK\" [COUNTRY]" >&2
    exit 1
fi

SSID=$1
PSK=$2
COUNTRY=${3:-}

if [ -n "$COUNTRY" ]; then
    iw reg set "$COUNTRY" 2>/dev/null || true
fi

# Close the bootstrap hotspot, hand the radio back to NetworkManager and
# connect to the home WiFi.
if ! /usr/local/sbin/phoniebox-wifi-connect "$SSID" "$PSK"; then
    echo "ERROR: could not connect. Check SSID/PSK and try again." >&2
    exit 1
fi

if getent hosts deb.debian.org >/dev/null 2>&1 \
   && curl -4 -fsS -m 8 -o /dev/null http://deb.debian.org/; then
    echo "OK: connected and internet is reachable."
    echo "The Phoniebox installation will start automatically - this takes 20-60 minutes."
    echo "Progress: ssh phoniebox@<ip-of-the-box> 'tail -f ~/INSTALL-*.log'"
else
    echo "Connected, but internet is not reachable yet."
    echo "The installation will start automatically once internet access is available."
fi
