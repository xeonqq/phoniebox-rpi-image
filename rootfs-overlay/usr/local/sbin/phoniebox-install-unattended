#!/usr/bin/env bash
# Unattended Phoniebox installation driver.
#
# Runs AS the phoniebox user (invoked from phoniebox-firstboot). It
# replicates installation/install-jukebox.sh + routines/install.sh but
# replaces the interactive welcome()/customize_options()/finish()
# prompts with variables pre-set in /etc/phoniebox-image/preseed.env,
# so the whole installation runs without any user input.

export LC_ALL=C
export DEBIAN_FRONTEND=${DEBIAN_FRONTEND:-noninteractive}
umask 022

STATUS_DIR=/var/lib/phoniebox-image
PRESEED_FILE=/etc/phoniebox-image/preseed.env

[ -f "$PRESEED_FILE" ] && . "$PRESEED_FILE"

GIT_USER=${GIT_USER:-xeonqq}
GIT_BRANCH=${GIT_BRANCH:-future3/develop}
GIT_REPO_NAME="RPi-Jukebox-RFID"
GIT_URL="https://github.com/${GIT_USER}/${GIT_REPO_NAME}"

CURRENT_USER="$(whoami)"
CURRENT_USER_GROUP="$(id -gn "$CURRENT_USER")"
HOME_PATH="$(getent passwd "$CURRENT_USER" | cut -d: -f6)"
INSTALLATION_PATH="${HOME_PATH}/${GIT_REPO_NAME}"
INSTALL_ID="$(date +%s)"
INSTALLATION_LOGFILE="${HOME_PATH}/INSTALL-${INSTALL_ID}.log"

# Same file descriptor layout as install-jukebox.sh: fd3 = console,
# stdout+stderr -> install log.
exec 3>&1 1>>"$INSTALLATION_LOGFILE" 2>&1
echo "Log start: ${INSTALL_ID} (unattended driver, branch ${GIT_BRANCH})"

print_lc() { echo -e "$1" 1>&3; }
log()      { echo -e "$1"; }
print_c()  { echo -e "$1" 1>&3; }
clear_c()  { true; }

exit_on_error() {
    print_lc "\n****************************************"
    print_lc "ERROR OCCURRED! Check the install log:"
    print_lc "$INSTALLATION_LOGFILE"
    [ -n "${1:-}" ] && print_lc "$1"
    print_lc "****************************************"
    log "Abort!"
    touch "${HOME_PATH}/.phoniebox-install-failed"
    exit 1
}

### Load the Phoniebox installer sources ---------------------------------

if [ ! -d "${INSTALLATION_PATH}" ]; then
    print_c "Staging Phoniebox source ..."
    cd "${HOME_PATH}" || exit_on_error "Cannot access home dir"
    if [ -d /opt/Phoniebox/.git ]; then
        exit_on_error "Root should have staged /opt/Phoniebox to ${INSTALLATION_PATH}"
    fi
    wget -qO- "${GIT_URL}/tarball/${GIT_BRANCH}" | tar xz || exit_on_error "Download failed"
    git_repo_download=$(find . -maxdepth 1 -type d -iname "${GIT_USER}-${GIT_REPO_NAME}-*")
    GIT_HASH=$(echo "$git_repo_download" | sed -rn "s/.*${GIT_USER}-${GIT_REPO_NAME}-([0-9a-fA-F]+)/\1/ip")
    [ -z "$git_repo_download" ] && exit_on_error "Couldn't find git download"
    [ -z "$GIT_HASH" ] && exit_on_error "Couldn't determine git hash"
    mv "$git_repo_download" "$GIT_REPO_NAME" || exit_on_error "mv failed"
fi

for i in "${INSTALLATION_PATH}"/installation/includes/*; do . "$i" || exit_on_error; done
for j in "${INSTALLATION_PATH}"/installation/routines/*; do
    # Skip local leftovers that are not valid shell (e.g. editor/merge debris)
    if grep -qE '^(<<<<<<<|=======$|>>>>>>>)' "$j" 2>/dev/null; then
        log "WARNING: skipping routine with conflict markers: $j"
        continue
    fi
    . "$j" || exit_on_error
done

# includes/01_default_config.sh hard-sets the installer defaults, which
# would clobber the preseed values sourced at the top. Re-apply the
# preseed so user settings win; the ${VAR:-default} fallbacks below only
# fill in values that are in neither file.
[ -f "$PRESEED_FILE" ] && . "$PRESEED_FILE"

### Ensure the user manager is reachable ---------------------------------

# A lot of routines use "systemctl --user" (e.g. enabling jukebox-daemon).
# That requires the user's systemd manager and $XDG_RUNTIME_DIR, which a
# bare "runuser -l" session does not provide - the enable then silently
# fails and the verify steps abort the installation. Start a persistent
# user manager (linger) and point the environment at it.
USER_UID="$(id -u)"
export XDG_RUNTIME_DIR="/run/user/${USER_UID}"
if ! sudo loginctl enable-linger "$CURRENT_USER" >/dev/null 2>&1; then
    log "WARNING: could not enable linger for $CURRENT_USER"
fi
for i in $(seq 1 15); do
    [ -S "${XDG_RUNTIME_DIR}/bus" ] && break
    sleep 2
done
if [ -S "${XDG_RUNTIME_DIR}/bus" ]; then
    log "User manager reachable at ${XDG_RUNTIME_DIR}/bus"
else
    log "WARNING: no user bus at ${XDG_RUNTIME_DIR} - 'systemctl --user' may fail"
fi

### Pre-selected options (replaces customize_options) --------------------

LOCAL_HOSTNAME="$(hostname)"

# _presed_has VAR -> true when VAR was set in the preseed file. Vars set
# there were re-applied above; everything else gets the image default
# below, overriding the upstream 01_default_config.sh hard-set values.
_PRESEED_KEYS=$(grep -oE '^[A-Za-z_][A-Za-z0-9_]*' "$PRESEED_FILE" 2>/dev/null | sort -u || true)
_presed_has() { echo "$_PRESEED_KEYS" | grep -qx "$1"; }

# Static IP cannot be combined with the WiFi hotspot: always off.
ENABLE_STATIC_IP=false

_presed_has DISABLE_IPv6                 || DISABLE_IPv6=true
_presed_has ENABLE_AUTOHOTSPOT           || ENABLE_AUTOHOTSPOT=true
_presed_has AUTOHOTSPOT_PROFILE          || AUTOHOTSPOT_PROFILE=Phoniebox_Hotspot
# customize_options appends the hostname to avoid SSID collisions
_presed_has AUTOHOTSPOT_SSID             || AUTOHOTSPOT_SSID="${AUTOHOTSPOT_PROFILE}_${LOCAL_HOSTNAME}"
AUTOHOTSPOT_SSID="${AUTOHOTSPOT_SSID:0:32}"
_presed_has AUTOHOTSPOT_PASSWORD         || AUTOHOTSPOT_PASSWORD="PlayItLoud!"
_presed_has AUTOHOTSPOT_IP               || AUTOHOTSPOT_IP=10.0.0.1
_presed_has AUTOHOTSPOT_COUNTRYCODE      || AUTOHOTSPOT_COUNTRYCODE=DE
_presed_has DISABLE_BLUETOOTH            || DISABLE_BLUETOOTH=true
_presed_has DISABLE_BOOT_SCREEN          || DISABLE_BOOT_SCREEN=true
_presed_has DISABLE_BOOT_LOGS_PRINT      || DISABLE_BOOT_LOGS_PRINT=true
_presed_has SETUP_MPD                    || SETUP_MPD=true
_presed_has ENABLE_MPD_OVERWRITE_INSTALL || ENABLE_MPD_OVERWRITE_INSTALL=true
_presed_has UPDATE_RASPI_OS              || UPDATE_RASPI_OS=false
_presed_has ENABLE_RFID_READER           || ENABLE_RFID_READER=true
_presed_has ENABLE_SAMBA                 || ENABLE_SAMBA=true
_presed_has ENABLE_WEBAPP                || ENABLE_WEBAPP=true
_presed_has ENABLE_KIOSK_MODE            || ENABLE_KIOSK_MODE=false
_presed_has DISABLE_ONBOARD_AUDIO        || DISABLE_ONBOARD_AUDIO=false
_presed_has ENABLE_WEBAPP_PROD_DOWNLOAD  || ENABLE_WEBAPP_PROD_DOWNLOAD=release-only
GIT_USE_SSH=false                          # no SSH keys on the device

# Current network facts; only needed when ENABLE_STATIC_IP were true,
# but some helpers reference them so keep sane fallbacks in place.
CURRENT_ROUTE=$(ip route get 8.8.8.8 2>/dev/null || true)
CURRENT_GATEWAY=$(echo "${CURRENT_ROUTE}" | awk '{ print $3; exit }')
CURRENT_INTERFACE=$(echo "${CURRENT_ROUTE}" | awk '{ print $5; exit }')
CURRENT_IP_ADDRESS=$(echo "${CURRENT_ROUTE}" | awk '{ print $7; exit }')

log "Pre-selected options:"
log "  ENABLE_AUTOHOTSPOT=${ENABLE_AUTOHOTSPOT} SSID=${AUTOHOTSPOT_SSID}"
log "  AUTOHOTSPOT_IP=${AUTOHOTSPOT_IP} COUNTRY=${AUTOHOTSPOT_COUNTRYCODE}"
log "  DISABLE_IPv6=${DISABLE_IPv6} DISABLE_BLUETOOTH=${DISABLE_BLUETOOTH}"
log "  DISABLE_ONBOARD_AUDIO=${DISABLE_ONBOARD_AUDIO}"
log "  SETUP_MPD=${SETUP_MPD} ENABLE_RFID_READER=${ENABLE_RFID_READER}"
log "  ENABLE_SAMBA=${ENABLE_SAMBA} ENABLE_WEBAPP=${ENABLE_WEBAPP}"
log "  ENABLE_KIOSK_MODE=${ENABLE_KIOSK_MODE} UPDATE_RASPI_OS=${UPDATE_RASPI_OS}"

### Install (mirrors routines/install.sh minus interactive parts) --------

install() {
    show_slow_hardware_message
    # prepare_dependencies collects+installs all apt packages and calls
    # update_raspi_os internally (new in future3, replaces the old
    # per-routine apt calls and set_ssh_qos, which was removed upstream).
    prepare_dependencies
    set_raspi_config
    # init_git_repo_from_tardir is skipped: /opt/Phoniebox (cloned at
    # image build time from the xeonqq fork) was staged as a regular
    # git repository in the user's home dir.
    setup_jukebox_core
    setup_mpd
    setup_samba
    setup_jukebox_webapp
    if [ "${ENABLE_WEBAPP}" = true ]; then
        setup_kiosk_mode
    fi
    if [ "${ENABLE_RFID_READER}" = true ]; then
        # Bypass the upstream interactive setup_rfid_reader routine.
        # Instead, call the component script directly with --default-reader
        # (implemented in run_register_rfid_reader.py) to write the config
        # non-interactively for the selected reader.
        RFID_READER_NAME=${RFID_READER_NAME:-rc522_spi}
        log "Registering RFID reader '${RFID_READER_NAME}' (non-interactive)"
        bash "${INSTALLATION_PATH}/installation/components/setup_rfid_reader.sh" \
            -r "${RFID_READER_NAME}" -d no -f
    fi
    optimize_boot_time
    setup_autohotspot
    setup_postinstall
    cleanup
}

if install; then
    touch "${HOME_PATH}/.phoniebox-install-success"
    print_lc "\nDONE: Phoniebox installation finished (unattended)."
    log "DONE"
    exit 0
fi

exit_on_error "install() returned non-zero"